# What builds the wheel: the build backend pyproject.toml names, and what it needs, each by hash, so the same tree gives
# the same wheel on every machine (scripts/release.py: uv build --build-constraints requirements/build.txt --require-hashes).
# Compile again when the backend moves (and move its version in pyproject.toml with it):
#   uv pip compile requirements/build.in --generate-hashes --python-version 3.12 --no-config -o requirements/build.txt
